<%# Detalle de grupo — tabla de posiciones + partidos %>

<%= link_to "&larr; Todos los grupos".html_safe, groups_path,
      class: "back-link",
      style: "font-family:'Space Mono',monospace;font-size:12px;color:#9a9ab5;letter-spacing:.05em;text-decoration:none" %>

<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin:14px 0 26px">
  <h1 style="font-family:'Press Start 2P',monospace;font-size:30px;color:#FFD400;margin:0;letter-spacing:.03em">
    GRUPO <%= @group[:name] %>
  </h1>
  <% unless @group[:completed] %>
    <%= form_with url: simulate_group_path(@group[:id]), method: :post, local: true do |f| %>
      <%= f.submit "SIMULAR GRUPO",
            class: "btn-simulate",
            style: "cursor:pointer;font-family:'Press Start 2P',monospace;font-size:9px;letter-spacing:.04em;padding:12px 18px;border-radius:5px;background:transparent;color:#7B93FF;border:2px dotted #2A3FE5;transition:all .2s" %>
    <% end %>
  <% end %>
</div>

<div style="background:#0b0b16;border:2px dotted #2A3FE5;border-radius:8px;padding:22px;margin-bottom:30px">
  <div style="font-size:11px;color:#6f6f99;letter-spacing:.12em;margin-bottom:16px">TABLA DE POSICIONES</div>
  <%= render "shared/standings_table", rows: @group[:standings], big: true %>
</div>

<% played_count  = @group[:matches].count { |m| m[:played] } %>
<% pending_count = @group[:matches].count { |m| !m[:played] } %>

<div style="font-family:'Press Start 2P',monospace;font-size:13px;color:#fff;letter-spacing:.04em;margin-bottom:18px">
  PARTIDOS &middot; <span style="color:#6f6f99"><%= played_count %> jugados &middot; <%= pending_count %> pendientes</span>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;">
  <% @group[:matches].each do |match| %>
    <%= render "shared/match_card", match: match %>
  <% end %>
</div>
