<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Copa Mundial FIFA 2026</title>
    <%= stylesheet_link_tag "tailwind", "application", data: { turbo_track: "reload" } %>
  </head>
  <body class="bg-gray-950 text-white min-h-screen">

    <nav class="bg-gray-900 border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-6">
        <%= link_to "🏆 FIFA 2026", root_path, class: "text-yellow-400 font-bold text-lg" %>
        <%= link_to "Grupos",       groups_path,   class: "text-gray-300 hover:text-white" %>
        <%= link_to "Partidos",     matches_path,  class: "text-gray-300 hover:text-white" %>
        <%= link_to "Eliminatorias", knockout_path, class: "text-gray-300 hover:text-white" %>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

  </body>
</html>
