<%# Eliminatorias — bracket con registro interactivo de resultados (localStorage) %>

<h1 style="font-family:'Press Start 2P',monospace;font-size:24px;color:#FFD400;margin:0 0 22px;letter-spacing:.02em">
  FASE ELIMINATORIA
</h1>

<% if @locked %>
  <%# Estado bloqueado %>
  <div style="background:#0b0b16;border:3px dotted #DC2626;border-radius:10px;padding:48px 28px;text-align:center;max-width:620px;margin:30px auto">
    <div style="font-size:30px;margin-bottom:18px">&#128274;</div>
    <div style="font-family:'Press Start 2P',monospace;font-size:13px;color:#F4B9B0;line-height:1.7;margin-bottom:14px">FASE BLOQUEADA</div>
    <p style="color:#9a9ab5;font-size:13px;line-height:1.7;margin:0 0 8px">
      Primero deben completarse <strong style="color:#fff">todos</strong> los partidos de la fase de grupos.
    </p>
    <p style="color:#FFD400;font-family:'Press Start 2P',monospace;font-size:9px;letter-spacing:.05em;margin:18px 0 0">
      FALTAN <%= @remaining %> PARTIDOS
    </p>
    <%= link_to "IR A PARTIDOS &rarr;".html_safe, matches_path,
          style: "display:inline-block;margin-top:22px;text-decoration:none;font-family:'Press Start 2P',monospace;font-size:9px;color:#000;background:#FFD400;padding:12px 16px;border-radius:4px;letter-spacing:.05em" %>
  </div>

<% else %>
  <%# Tip de interacción %>
  <div style="display:flex;align-items:center;gap:10px;background:rgba(255,212,0,.06);border:1px dotted #FFD400;border-radius:6px;padding:11px 14px;margin-bottom:18px;flex-wrap:wrap">
    <span class="status-dot" style="flex-shrink:0"></span>
    <span style="font-family:'Space Mono',monospace;font-size:12px;color:#c8c8e0;letter-spacing:.02em">
      Haz clic en cualquier llave <span style="color:#FFD400">parpadeante</span> para registrar el resultado. El ganador avanza automáticamente.
    </span>
  </div>

  <%# Bracket %>
  <div style="overflow-x:auto;padding:6px 2px 24px">
    <div style="display:flex;gap:22px;align-items:stretch;min-width:max-content">

      <% @rounds.each do |round| %>
        <div style="display:flex;flex-direction:column;min-width:200px">
          <div style="font-family:'Press Start 2P',monospace;font-size:9px;color:#FFD400;letter-spacing:.05em;text-align:center;padding:10px;border:2px dotted #2A3FE5;border-radius:5px;margin-bottom:14px">
            <%= round[:name] %>
          </div>
          <div style="display:flex;flex-direction:column;justify-content:space-around;gap:10px;flex:1">
            <% round[:matches].each_with_index do |bm, bm_idx| %>
              <div class="knock-cell"
                   data-match-id="<%= bm[:id] %>"
                   data-phase="<%= bm[:phase] %>"
                   data-idx="<%= bm_idx %>"
                   data-home-code="<%= bm[:home][:code] %>"
                   data-home-name="<%= bm[:home][:name] %>"
                   data-away-code="<%= bm[:away][:code] %>"
                   data-away-name="<%= bm[:away][:name] %>"
                   data-played="<%= bm[:played] ? '1' : '0' %>"
                   style="cursor:pointer;background:#0b0b16;border:2px dotted #2A3FE5;border-radius:6px;overflow:hidden;transition:transform .1s"
                   onmouseover="this.style.transform='scale(1.03)'"
                   onmouseout="this.style.transform=''">
                <div class="knock-home-row" style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 11px;background:<%= bm[:home_bg] %>">
                  <span class="knock-home-code" style="font-family:'Press Start 2P',monospace;font-size:10px;color:<%= bm[:home_color] %>"><%= bm[:home][:code] %></span>
                  <span class="knock-home-goals" style="font-family:'Press Start 2P',monospace;font-size:11px;color:<%= bm[:home_color] %>"><%= bm[:home_goals] || "·" %></span>
                </div>
                <div style="height:1px;background:#2A3FE5;opacity:.4"></div>
                <div class="knock-away-row" style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 11px;background:<%= bm[:away_bg] %>">
                  <span class="knock-away-code" style="font-family:'Press Start 2P',monospace;font-size:10px;color:<%= bm[:away_color] %>"><%= bm[:away][:code] %></span>
                  <span class="knock-away-goals" style="font-family:'Press Start 2P',monospace;font-size:11px;color:<%= bm[:away_color] %>"><%= bm[:away_goals] || "·" %></span>
                </div>
                <div class="knock-pen-row" style="text-align:center;font-size:9px;color:#F4B9B0;padding:<%= bm[:pen_text].present? ? '5px 0 3px' : '0' %>">
                  <%= bm[:pen_text] %>
                </div>
                <div class="knock-status-row" style="text-align:center;font-family:'Press Start 2P',monospace;font-size:6px;letter-spacing:.08em;color:<%= bm[:played] ? '#6f6f99' : '#FFD400' %>;padding:6px 0 7px">
                  <%= bm[:played] ? "EDITAR" : "REGISTRAR" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Columna campeón %>
      <div style="display:flex;flex-direction:column;justify-content:center;min-width:200px">
        <div id="champion-box" style="background:#11110a;border:3px solid #FFD400;border-radius:8px;padding:22px 16px;text-align:center;animation:glow 2.2s ease-in-out infinite">
          <div style="font-size:30px;margin-bottom:8px;animation:trophyb 2.2s ease-in-out infinite">&#127942;</div>
          <div style="font-family:'Press Start 2P',monospace;font-size:8px;color:#FFD400;letter-spacing:.06em;margin-bottom:12px">CAMPEÓN</div>
          <div id="champion-code" style="font-family:'Press Start 2P',monospace;font-size:16px;color:<%= @champion ? '#fff' : '#46465e' %>">
            <%= @champion ? @champion[:code] : "—" %>
          </div>
          <div id="champion-name" style="font-size:11px;color:#7a7a9a;margin-top:8px">
            <%= @champion ? @champion[:name] : "Por definir" %>
          </div>
        </div>
      </div>

    </div>
  </div>

  <%# Tercer lugar %>
  <% if @third %>
    <div style="margin-top:14px;max-width:340px">
      <div style="font-family:'Press Start 2P',monospace;font-size:9px;color:#CD7F32;letter-spacing:.05em;margin-bottom:12px">PARTIDO POR EL TERCER LUGAR</div>
      <div class="knock-cell"
           data-match-id="<%= @third[:id] %>"
           data-phase="3rd"
           data-idx="0"
           data-home-code="<%= @third[:home][:code] %>"
           data-home-name="<%= @third[:home][:name] %>"
           data-away-code="<%= @third[:away][:code] %>"
           data-away-name="<%= @third[:away][:name] %>"
           data-played="<%= @third[:played] ? '1' : '0' %>"
           style="cursor:pointer;background:#0b0b16;border:2px dotted #CD7F32;border-radius:6px;overflow:hidden">
        <div class="knock-home-row" style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:11px 13px;">
          <span class="knock-home-code" style="font-family:'Press Start 2P',monospace;font-size:11px;color:#fff"><%= @third[:home][:code] %></span>
          <span class="knock-home-goals" style="font-family:'Press Start 2P',monospace;font-size:12px;color:#fff"><%= @third[:home_goals] || "·" %></span>
        </div>
        <div style="height:1px;background:#CD7F32;opacity:.4"></div>
        <div class="knock-away-row" style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:11px 13px;">
          <span class="knock-away-code" style="font-family:'Press Start 2P',monospace;font-size:11px;color:#fff"><%= @third[:away][:code] %></span>
          <span class="knock-away-goals" style="font-family:'Press Start 2P',monospace;font-size:12px;color:#fff"><%= @third[:away_goals] || "·" %></span>
        </div>
        <div class="knock-pen-row" style="text-align:center;font-size:9px;color:#F4B9B0;padding:<%= @third[:pen_text].present? ? '5px 0 3px' : '0' %>">
          <%= @third[:pen_text] %>
        </div>
        <div class="knock-status-row" style="text-align:center;font-family:'Press Start 2P',monospace;font-size:6px;letter-spacing:.08em;color:<%= @third[:played] ? '#6f6f99' : '#FFD400' %>;padding:6px 0 8px">
          <%= @third[:played] ? "EDITAR" : "REGISTRAR" %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<%# Modal para registrar resultados de eliminatorias (localStorage) %>
<div id="knock-modal-backdrop" style="display:none;position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.8);backdrop-filter:blur(3px);align-items:center;justify-content:center;padding:20px;animation:fadein .16s ease">
  <div id="knock-modal" style="width:100%;max-width:440px;background:#0b0b16;border:3px dotted #FFD400;border-radius:12px;padding:26px;animation:popin .22s cubic-bezier(.2,.8,.2,1)">
    <div id="km-round-name" style="font-family:'Press Start 2P',monospace;font-size:9px;color:#FFD400;letter-spacing:.06em;text-align:center;margin-bottom:6px"></div>
    <div style="text-align:center;font-size:11px;color:#6f6f99;letter-spacing:.08em;margin-bottom:22px">REGISTRAR RESULTADO</div>

    <div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:start;gap:12px;margin-bottom:6px">
      <div style="text-align:center">
        <div id="km-home-code" style="font-family:'Press Start 2P',monospace;font-size:15px;color:#fff"></div>
        <div id="km-home-name" style="font-size:10px;color:#7a7a9a;margin-top:7px;line-height:1.3"></div>
      </div>
      <span style="color:#6f6f99;font-family:'Press Start 2P',monospace;font-size:9px;padding-top:4px">VS</span>
      <div style="text-align:center">
        <div id="km-away-code" style="font-family:'Press Start 2P',monospace;font-size:15px;color:#fff"></div>
        <div id="km-away-name" style="font-size:10px;color:#7a7a9a;margin-top:7px;line-height:1.3"></div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;margin:16px 0 8px">
      <input id="km-gh" type="number" min="0" inputmode="numeric"
        style="width:100%;height:54px;text-align:center;font-family:'Press Start 2P',monospace;font-size:18px;background:#000;color:#FFD400;border:2px solid #FFD400;border-radius:7px;outline:none" />
      <span style="color:#6f6f99;font-family:'Press Start 2P',monospace;font-size:14px">:</span>
      <input id="km-ga" type="number" min="0" inputmode="numeric"
        style="width:100%;height:54px;text-align:center;font-family:'Press Start 2P',monospace;font-size:18px;background:#000;color:#FFD400;border:2px solid #FFD400;border-radius:7px;outline:none" />
    </div>
    <div style="text-align:center;font-size:9px;color:#6f6f99;letter-spacing:.06em">GOLES &middot; 90 MIN + TIEMPO EXTRA</div>

    <div id="km-pen-section" style="display:none;margin-top:18px;padding-top:18px;border-top:2px dotted #2A3FE5;animation:rise .22s ease">
      <div style="text-align:center;font-family:'Press Start 2P',monospace;font-size:8px;color:#F4B9B0;letter-spacing:.05em;line-height:1.6;margin-bottom:14px">
        &#9917; EMPATE &rarr; DEFINICIÓN POR PENALES
      </div>
      <div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px">
        <input id="km-ph" type="number" min="0" inputmode="numeric"
          style="width:100%;height:46px;text-align:center;font-family:'Press Start 2P',monospace;font-size:15px;background:#000;color:#F4B9B0;border:2px solid #F4B9B0;border-radius:7px;outline:none" />
        <span style="color:#6f6f99;font-family:'Press Start 2P',monospace;font-size:12px">:</span>
        <input id="km-pa" type="number" min="0" inputmode="numeric"
          style="width:100%;height:46px;text-align:center;font-family:'Press Start 2P',monospace;font-size:15px;background:#000;color:#F4B9B0;border:2px solid #F4B9B0;border-radius:7px;outline:none" />
      </div>
      <div style="text-align:center;font-size:9px;color:#6f6f99;letter-spacing:.06em;margin-top:8px">PENALES</div>
    </div>

    <div id="km-err" style="display:none;text-align:center;font-family:'Space Mono',monospace;font-size:11px;color:#DC2626;margin-top:16px;line-height:1.5"></div>

    <div style="display:flex;gap:10px;margin-top:24px">
      <button id="km-save" style="flex:1;cursor:pointer;font-family:'Press Start 2P',monospace;font-size:9px;letter-spacing:.04em;padding:14px;border-radius:6px;background:#FFD400;color:#000;border:none">GUARDAR</button>
      <button id="km-simulate" class="btn-simulate" style="cursor:pointer;font-family:'Press Start 2P',monospace;font-size:9px;letter-spacing:.04em;padding:14px;border-radius:6px;background:transparent;color:#7B93FF;border:2px dotted #2A3FE5">SIMULAR</button>
      <button id="km-close" style="cursor:pointer;font-family:'Press Start 2P',monospace;font-size:9px;letter-spacing:.04em;padding:14px 16px;border-radius:6px;background:transparent;color:#9a9ab5;border:2px dotted #3a3a52">X</button>
    </div>
  </div>
</div>

<% unless @locked %>
<script>
(function() {
  let currentId = null;

  function decorateCells() {
    document.querySelectorAll('.knock-cell').forEach(function(cell) {
      if (cell.dataset.played !== '1') {
        cell.style.borderStyle = 'solid';
        cell.style.borderColor = '#FFD400';
        cell.style.animation   = 'pulseB 1.9s ease-in-out infinite';
      }
    });
  }

  function openModal(cell) {
    currentId = cell.dataset.matchId;
    const played = cell.dataset.played === '1';

    document.getElementById('km-home-code').textContent = cell.dataset.homeCode;
    document.getElementById('km-home-name').textContent = cell.dataset.homeName;
    document.getElementById('km-away-code').textContent = cell.dataset.awayCode;
    document.getElementById('km-away-name').textContent = cell.dataset.awayName;

    if (played) {
      const hgText = cell.querySelector('.knock-home-goals').textContent.trim();
      const agText = cell.querySelector('.knock-away-goals').textContent.trim();
      document.getElementById('km-gh').value = (hgText && hgText !== '·') ? hgText : '';
      document.getElementById('km-ga').value = (agText && agText !== '·') ? agText : '';
      const penText = cell.querySelector('.knock-pen-row').textContent.trim();
      if (penText.startsWith('PENALES ')) {
        const parts = penText.replace('PENALES ', '').split('-');
        document.getElementById('km-ph').value = parts[0] || '';
        document.getElementById('km-pa').value = parts[1] || '';
      } else {
        document.getElementById('km-ph').value = '';
        document.getElementById('km-pa').value = '';
      }
    } else {
      document.getElementById('km-gh').value = '';
      document.getElementById('km-ga').value = '';
      document.getElementById('km-ph').value = '';
      document.getElementById('km-pa').value = '';
    }

    document.getElementById('km-err').style.display = 'none';
    document.getElementById('km-err').textContent   = '';

    const ghVal = parseInt(document.getElementById('km-gh').value, 10);
    const gaVal = parseInt(document.getElementById('km-ga').value, 10);
    document.getElementById('km-pen-section').style.display =
      (!isNaN(ghVal) && !isNaN(gaVal) && ghVal === gaVal) ? 'block' : 'none';

    document.getElementById('knock-modal-backdrop').style.display = 'flex';
  }

  function closeModal() {
    document.getElementById('knock-modal-backdrop').style.display = 'none';
    currentId = null;
  }

  function saveModal() {
    if (!currentId) return;
    const ghRaw = document.getElementById('km-gh').value;
    const gaRaw = document.getElementById('km-ga').value;
    const gh = parseInt(ghRaw, 10), ga = parseInt(gaRaw, 10);
    const errEl = document.getElementById('km-err');

    if (ghRaw===''||gaRaw===''||isNaN(gh)||isNaN(ga)||gh<0||ga<0||gh>99||ga>99) {
      errEl.textContent = 'Ingresa goles válidos (0–99).'; errEl.style.display = 'block'; return;
    }

    let ph = 0, pa = 0;
    if (gh === ga) {
      const phRaw = document.getElementById('km-ph').value;
      const paRaw = document.getElementById('km-pa').value;
      ph = parseInt(phRaw, 10); pa = parseInt(paRaw, 10);
      if (phRaw===''||paRaw===''||isNaN(ph)||isNaN(pa)||ph<0||pa<0||ph>99||pa>99) {
        errEl.textContent = 'Empate: ingresa el marcador de penales.'; errEl.style.display = 'block'; return;
      }
      if (ph === pa) {
        errEl.textContent = 'Los penales no pueden quedar empatados.'; errEl.style.display = 'block'; return;
      }
    }

    const saveBtn = document.getElementById('km-save');
    saveBtn.textContent = 'GUARDANDO...';
    saveBtn.disabled = true;

    const csrfMeta = document.querySelector('meta[name="csrf-token"]');
    const csrfToken = csrfMeta ? csrfMeta.content : '';

    fetch('/knockout/matches/' + currentId + '/result', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ home_goals: gh, away_goals: ga, home_penalties: ph, away_penalties: pa })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.ok) {
        window.location.reload();
      } else {
        errEl.textContent = data.error || 'Error al guardar el resultado.';
        errEl.style.display = 'block';
        saveBtn.textContent = 'GUARDAR';
        saveBtn.disabled = false;
      }
    })
    .catch(function() {
      errEl.textContent = 'Error de conexión con el servidor.';
      errEl.style.display = 'block';
      saveBtn.textContent = 'GUARDAR';
      saveBtn.disabled = false;
    });
  }

  function simulateModal() {
    if (!currentId) return;
    var btn = document.getElementById('km-simulate');
    btn.textContent = 'SIMULANDO...';
    btn.disabled = true;

    var csrfMeta = document.querySelector('meta[name="csrf-token"]');
    var csrfToken = csrfMeta ? csrfMeta.content : '';

    fetch('/knockout/matches/' + currentId + '/simulate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.ok) {
        window.location.reload();
      } else {
        var errEl = document.getElementById('km-err');
        errEl.textContent = data.error || 'Error al simular.';
        errEl.style.display = 'block';
        btn.textContent = 'SIMULAR';
        btn.disabled = false;
      }
    })
    .catch(function() {
      var errEl = document.getElementById('km-err');
      errEl.textContent = 'Error de conexion.';
      errEl.style.display = 'block';
      btn.textContent = 'SIMULAR';
      btn.disabled = false;
    });
  }

  function onGoalInput() {
    const gh = parseInt(document.getElementById('km-gh').value, 10);
    const ga = parseInt(document.getElementById('km-ga').value, 10);
    document.getElementById('km-pen-section').style.display =
      (!isNaN(gh) && !isNaN(ga) && gh === ga) ? 'block' : 'none';
    document.getElementById('km-err').style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function() {
    decorateCells();

    document.querySelectorAll('.knock-cell').forEach(function(cell) {
      cell.addEventListener('click', function() { openModal(cell); });
    });

    document.getElementById('km-save').addEventListener('click', saveModal);
    document.getElementById('km-simulate').addEventListener('click', simulateModal);
    document.getElementById('km-close').addEventListener('click', closeModal);
    document.getElementById('km-gh').addEventListener('input', onGoalInput);
    document.getElementById('km-ga').addEventListener('input', onGoalInput);
    document.getElementById('knock-modal-backdrop').addEventListener('click', function(e) {
      if (e.target === this) closeModal();
    });
  });
})();
</script>
<% end %>
