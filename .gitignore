# Archivos y carpetas que NO se suben a git porque se generan en cada máquina.
# Ver https://help.github.com/articles/ignoring-files para más info.

# --------------------------BACKEND--------------------------

# Logs generados en tiempo de ejecución.
/backend/log/*
!/backend/log/.keep

# Archivos temporales (caché, PIDs del servidor, etc.).
/backend/tmp/*
!/backend/tmp/.keep
/backend/tmp/pids/*
!/backend/tmp/pids/.keep

# Base de datos SQLite (cada quien la regenera con rails db:setup).
/backend/storage/*
!/backend/storage/.keep
/backend/db/*.sqlite3
/backend/db/*.sqlite3-*

# Variables de entorno y secretos locales.
/backend/config/master.key
.env*

# Caché de bootsnap.
/backend/tmp/cache/bootsnap*

# Claude
/.claude

# Documentacion
/docs/architecture.md
/docs/database-design.md
/docs/decisions.md
/docs/domain-model.md
/docs/requirements.md

# --------------------------FRONTEND--------------------------

# Logs generados en tiempo de ejecución.
/frontend/log/*
!/frontend/log/.keep

# Archivos temporales (caché, PIDs del servidor, etc.).
/frontend/tmp/*
!/frontend/tmp/.keep

# Caché de bootsnap.
/frontend/tmp/cache/bootsnap*

# Caché de Sprockets (assets compilados).
/frontend/tmp/cache/assets/

# CSS compilado de Tailwind (se regenera con bin/dev).
/frontend/app/assets/builds/*
!/frontend/app/assets/builds/.keep

# Secretos locales.
/frontend/config/master.key